# Replace placeholders in a local terraform.tfvars file when deployment is authorized.
# Static validation does not load this example; required deployment inputs such as
# budget_alert_email, access_log_bucket_name, cloudtrail_bucket_name, and
# config_bucket_name must be supplied in a gitignored local terraform.tfvars file.
aws_region               = "<aws-region>"
environment              = "<environment>"
budget_monthly_limit_usd = 10
budget_alert_email       = "<budget-alert-email>"
access_log_bucket_name   = "<access-log-bucket-name>"
cloudtrail_bucket_name   = "<cloudtrail-logs-bucket-name>"
config_bucket_name       = "<config-logs-bucket-name>"

# Set to false if the account already has AWSServiceRoleForConfig from prior AWS Config usage.
config_create_service_linked_role = true

# Optional GuardDuty protection plans default to false (explicitly DISABLED) to
# avoid post-30-day-trial charges; S3 Protection is enabled unconditionally.
guardduty_enable_eks_audit_logs         = false
guardduty_enable_ebs_malware_protection = false
guardduty_enable_rds_login_events       = false
guardduty_enable_lambda_network_logs    = false
guardduty_enable_runtime_monitoring     = false
guardduty_enable_ai_protection          = false

# CIS AWS Foundations Benchmark standard version in Security Hub (1.2.0, 1.4.0, 3.0.0, or 5.0.0).
securityhub_cis_version = "5.0.0"
