# Replace placeholders in a local terraform.tfvars file when deployment is authorized.
# Static validation does not load this example; required deployment inputs such as
# budget_alert_email, access_log_bucket_name, and cloudtrail_bucket_name must be
# supplied in a gitignored local terraform.tfvars file.
aws_region               = "<aws-region>"
environment              = "<environment>"
budget_monthly_limit_usd = 10
budget_alert_email       = "<budget-alert-email>"
access_log_bucket_name   = "<access-log-bucket-name>"
cloudtrail_bucket_name   = "<cloudtrail-logs-bucket-name>"
